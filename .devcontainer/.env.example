# Plantilla para variables de entorno.
# Copiar este archivo a .env en la raíz del repo y completar valores.
# El .env está en .gitignore y NO se commitea.

# Azure SQL Edge — SA password (mínimo 8 caracteres, complejo)
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# ACCEPT_EULA requerido por Azure SQL Edge
ACCEPT_EULA=Y

# MSSQL_PID: Developer (gratis, solo dev) o Evaluation
MSSQL_PID=Developer

# Ollama host (no tocar salvo debug)
OLLAMA_HOST=0.0.0.0

# Opcional: Azure OpenAI para producción (no usar en dev local)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
